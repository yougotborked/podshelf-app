{
  "name": "podshelf",
  "version": "0.13.0",
  "author": "advplyr",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nuxi dev --host 0.0.0.0 --port 1337",
    "build": "nuxi build",
    "start": "nuxi preview --host 0.0.0.0 --port 1337",
    "generate": "nuxi generate",
    "lint": "eslint --ext .js,.vue .",
    "lint:fix": "npm run lint -- --fix",
    "sync": "nuxt generate && npx cap sync",
    "ci:android": "bash scripts/local-ci.sh",
    "verify": "bash scripts/verify.sh",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:update": "node scripts/typecheck.mjs --update",
    "check:i18n": "node scripts/check-i18n-sorted.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:android": "bash scripts/test-android.sh",
    "screenshots": "playwright test",
    "store:assets": "node scripts/store-assets.mjs",
    "store:listing": "node scripts/sync-play-listing.mjs",
    "icons-android": "cordova-res android --skip-config --copy",
    "ionic:build": "npm run build",
    "ionic:serve": "npm run dev",
    "devlive": "ionic cap run -l --external --port=1337"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.0",
    "@capacitor-community/volume-buttons": "^8.0.0",
    "@capacitor/android": "9.0.0-beta.0",
    "@capacitor/app": "9.0.0-alpha.2",
    "@capacitor/browser": "9.0.0-alpha.2",
    "@capacitor/clipboard": "9.0.0-alpha.2",
    "@capacitor/core": "9.0.0-beta.0",
    "@capacitor/dialog": "9.0.0-alpha.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "9.0.0-next.1",
    "@capacitor/ios": "9.0.0-beta.0",
    "@capacitor/network": "9.0.0-alpha.2",
    "@capacitor/preferences": "9.0.0-alpha.2",
    "@capacitor/share": "9.0.0-alpha.2",
    "@capacitor/status-bar": "9.0.0-alpha.2",
    "@pinia/nuxt": "^0.9.0",
    "@teckel/vue-pdf": "^4.3.5",
    "@vueuse/core": "^12.0.0",
    "@vueuse/nuxt": "^12.0.0",
    "buffer": "^6.0.3",
    "cordova-plugin-screen-orientation": "^3.0.4",
    "date-fns": "^3.6.0",
    "epubjs": "0.4.2",
    "fast-average-color": "^9.3.0",
    "libarchive.js": "^1.3.0",
    "mitt": "^3.0.1",
    "nuxt": "^4.6.3",
    "pinia": "^2.3.0",
    "socket.io-client": "^4.1.3",
    "tailwindcss": "^4.0.0",
    "vue-toastification": "^2.0.0-rc.5",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "9.0.0-beta.0",
    "@nuxtjs/eslint-config-typescript": "^12.0.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.57.1",
    "eslint-plugin-nuxt": "^4.0.0",
    "postcss": "^8.4.33",
    "typescript": "5.9.3",
    "vitest": "^5.0.5",
    "vue-tsc": "2.2.10"
  },
  "overrides": {
    "@capacitor/filesystem": {
      "@capacitor/core": "$@capacitor/core"
    },
    "@capacitor-community/keep-awake": {
      "@capacitor/core": "$@capacitor/core"
    },
    "@capacitor-community/volume-buttons": {
      "@capacitor/core": "$@capacitor/core"
    }
  }
}
