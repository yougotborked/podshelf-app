{
  "appId": "com.podshelf.app",
  "appName": "Podshelf",
  "webDir": ".output/public",
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    },
    "StatusBar": {
      "style": "DARK"
    }
  },
  "server": {
    "androidScheme": "http"
  },
  "android": {
    "includePlugins": [
      "@capacitor-community/keep-awake",
      "@capacitor-community/volume-buttons",
      "@capacitor/app",
      "@capacitor/browser",
      "@capacitor/clipboard",
      "@capacitor/dialog",
      "@capacitor/filesystem",
      "@capacitor/haptics",
      "@capacitor/network",
      "@capacitor/preferences",
      "@capacitor/share",
      "cordova-plugin-screen-orientation"
    ]
  }
}
